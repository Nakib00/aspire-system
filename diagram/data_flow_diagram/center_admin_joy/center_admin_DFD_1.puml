
@startuml
left to right direction

actor "Center Admin" as Admin

rectangle "1.0 Authenticate Admin" as P1
rectangle "2.0 View Dashboard" as P2
rectangle "3.0 Manage People" as P3
rectangle "4.0 Manage Subjects" as P4
rectangle "5.0 Manage Classes" as P5
rectangle "6.0 Manage Enrollment and Guardians" as P6

rectangle "[D1] Users" as D1
rectangle "[D2] Centers" as D2
rectangle "[D3] Subjects" as D3
rectangle "[D4] Classes / Sections" as D4
rectangle "[D5] Student-Class Enrollment" as D5
rectangle "[D6] Guardian-Student Relationships" as D6

Admin --> P1 : Login credentials
P1 --> D1 : Validate user
P1 --> D2 : Verify center
P1 --> Admin : Login result

Admin --> P2 : Dashboard request
P2 --> D1 : Read people data
P2 --> D3 : Read subject data
P2 --> D4 : Read class data
P2 --> D5 : Read enrollment data
P2 --> D6 : Read guardian data
P2 --> Admin : Statistics, schedules and alerts

Admin --> P3 : Manage students, parents and teachers
P3 --> D1 : Create, update, read and delete people
P3 --> D6 : Manage guardian links
P3 --> Admin : People records and results

Admin --> P4 : Manage subjects
P4 --> D3 : Read and write subject data
P4 --> D4 : Check linked classes
P4 --> Admin : Subject result

Admin --> P5 : Manage classes
P5 --> D4 : Read and write class data
P5 --> D3 : Validate subject
P5 --> D1 : Validate teachers
P5 --> Admin : Class details and result

Admin --> P6 : Enrollment and guardian requests
P6 --> D5 : Read and write enrollment
P6 --> D4 : Check class capacity
P6 --> D1 : Validate student and parent
P6 --> D6 : Read and write guardian links
P6 --> Admin : Enrollment and guardian result

@enduml
