skinparam databaseBorderColor #92400E

title Aspire Super Admin DFD Level 0 - Center Management
rectangle "Super Admin" as actor_in
database "D2: Centers" as centers_in
database "D1: Users" as users_in
usecase "2.0\nManage centers" as process
rectangle "Super Admin" as actor_out
database "D2: Centers" as centers_out
actor_in --> process : Center data;\nlist request
centers_in --> process : Center records
users_in --> process : Administrator counts
process --> actor_out : Center records;\nsave result
process --> centers_out : New or updated\ncenter data
legend bottom
  Repeated symbols represent the same actor or data store.
endlegend

@enduml

