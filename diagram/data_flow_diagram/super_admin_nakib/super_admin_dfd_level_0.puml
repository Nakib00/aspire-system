@startuml
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 90
skinparam ranksep 130
skinparam defaultFontSize 16
skinparam ArrowFontSize 13
skinparam rectangleBackgroundColor #F1F5F9
skinparam rectangleBorderColor #334155
skinparam usecaseBackgroundColor #E0F2FE
skinparam usecaseBorderColor #0369A1
skinparam databaseBackgroundColor #FEF3C7
skinparam databaseBorderColor #92400E

title Aspire Super Admin DFD Level 0 - Authentication
rectangle "Super Admin" as actor_in
 database "D1: Users" as users_in
usecase "1.0\nAuthenticate user" as process
rectangle "Super Admin" as actor_out
database "D1: Users" as users_out
actor_in --> process : Email and password;\nsign-out request
users_in --> process : Account and\ncredential data
process --> actor_out : Token and user details;\nauthentication result
process --> users_out : Last login time
legend bottom
  Repeated symbols represent the same actor or data store.
endlegend

@enduml

@startuml
left to right direction
skinparam shadowing false
